---
/**
 * Nosotros (E-E-A-T): quiénes somos, cómo trabajamos, cumplimiento y datos de la entidad.
 * ⚠️ Pendiente del cliente: historia, año de fundación, RUT y N° de autorización.
 * Fotos: reales del cliente (src/data/fotos-reales.ts); galería "En terreno".
 */
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Answer from '../../components/Answer.astro';
import Features from '../../components/Features.astro';
import Credential from '../../components/Credential.astro';
import CoverageMap from '../../components/CoverageMap.astro';
import CtaBand from '../../components/CtaBand.astro';
import Gallery from '../../components/Gallery.astro';
import HeroPreload from '../../components/HeroPreload.astro';
import { USO } from '../../data/fotos-reales';
import { SITE_URL } from '../../data/empresa';
import { nodoBreadcrumb, nodoPagina } from '../../data/schema';

const url = `${SITE_URL}/nosotros/`;
const title = 'Nosotros: empresa de seguridad privada | Invictus Security';
const description = 'Conoce a Invictus Security: empresa de seguridad privada de la Región Metropolitana con guardias acreditados, supervisión 24/7 y apego a la Ley 21.659.';
const crumbs = [{ nombre: 'Inicio', url: `${SITE_URL}/` }, { nombre: 'Nosotros', url }];
---
<Base title={title} description={description} path="/nosotros/" schema={[nodoPagina({ url, titulo: title, descripcion: description, tipo: 'AboutPage' }), nodoBreadcrumb(crumbs)]}>
  <HeroPreload slot="head" image={USO.nosotrosHero.src} />
  <Hero
    eyebrow="Nosotros"
    h1="Seguridad privada hecha con "
    h1Accent="disciplina y cercanía"
    lead="Somos una empresa de seguridad privada de la Región Metropolitana. Protegemos condominios, empresas, bodegas y eventos con guardias acreditados, supervisión constante y un trato directo con cada cliente."
    bullets={['Supervisión en terreno y a distancia', 'Reemplazos garantizados', 'Cumplimiento laboral y de seguridad privada']}
    image={USO.nosotrosHero.src}
    imageAlt={USO.nosotrosHero.alt}
    imagePosition={USO.nosotrosHero.pos}
    imageMobilePosition="40% 28%"
    tag="Equipo Invictus · turno de noche"
    breadcrumbs={crumbs}
  />
  <Answer
    pregunta="¿Quiénes somos?"
    respuesta="Invictus Security es una empresa de seguridad privada con sede en Peñaflor, Región Metropolitana. Diseñamos y operamos servicios de guardias de seguridad para comunidades, empresas e industrias, con un modelo basado en tres pilares: personal acreditado y bien seleccionado, supervisión continua de cada puesto y comunicación directa con el cliente."
  />
  <Features
    eyebrow="Cómo trabajamos"
    titulo="Lo que nos importa en cada servicio"
    items={[
      { titulo: 'Selección rigurosa', texto: 'Verificamos antecedentes, experiencia y credencial antes de asignar a un guardia a tu recinto.' },
      { titulo: 'Capacitación continua', texto: 'Procedimientos de control de acceso, rondas, emergencias y trato con las personas, adaptados a cada recinto.' },
      { titulo: 'Supervisión real', texto: 'Supervisores que visitan los puestos, controlan rondas y presentación, y responden ante el cliente.' },
      { titulo: 'Continuidad del servicio', texto: 'Reemplazos ante ausencias para que ningún puesto quede descubierto.' },
      { titulo: 'Cumplimiento', texto: 'Contratos, cotizaciones y seguros al día, y operación bajo la Ley 21.659 de Seguridad Privada.' },
      { titulo: 'Transparencia', texto: 'Propuestas claras, reportes de novedades y un contacto directo para resolver cualquier tema.' },
    ]}
  />
  <Gallery
    id="en-terreno"
    eyebrow="En terreno"
    titulo="Nuestro equipo y flota, en terreno"
    texto="Guardias, motoristas y camionetas de supervisión de Invictus Security en servicio."
    fotos={USO.galeriaNosotros}
  />
  <Credential />
  <CoverageMap />
  <CtaBand titulo="Conversemos sobre la seguridad de tu recinto" cta="Cotizar gratis" />
</Base>
