---
/**
 * /gracias/ — post-conversión. noindex. NUNCA enlazar a esta página.
 *
 * Medición condicionada: el formulario deja en sessionStorage `inv_lead`
 * { id, ts, segmento, user_data:{email, phone_number} }. Si existe (y tiene < 30 min):
 *   1) dataLayer: generate_lead { lead_id, segmento, user_data } (para GTM / GA4)
 *   2) GTM (solo en producción)
 *   3) gtag: conversión PRIMARIA de Ads (OcKZ…) con transaction_id y Enhanced Conversions.
 * Respaldo: sin token pero llegando desde el propio sitio → cuenta una vez por sesión.
 * Recargas, visitas directas y bots NO miden nada.
 *
 * ⚠️ Cuando GTM tenga su tag de Ads disparado por `generate_lead`, quitar el bloque gtag de abajo
 *    para no duplicar la conversión.
 */
import Base from '../../layouts/Base.astro';

const pasos = [
  { t: 'Revisamos tu solicitud', d: 'Un especialista analiza tu caso hoy mismo en horario hábil.' },
  { t: 'Te llamamos', d: 'Te contactamos al teléfono que dejaste para afinar detalles y, si corresponde, agendar una visita técnica gratuita.' },
  { t: 'Recibes tu propuesta', d: 'En menos de 24 horas hábiles tienes una propuesta con dotación, turnos y alcance del servicio.' },
];
---
<Base title="¡Solicitud recibida! | Invictus Security" description="Recibimos tu solicitud de cotización." path="/gracias/" noindex loadGtm={false} hideMobileBar minimalHeader>
  <script is:inline slot="head">
    (function () {
      var lead = null, counted = false;
      try {
        lead = JSON.parse(sessionStorage.getItem('inv_lead') || 'null');
        sessionStorage.removeItem('inv_lead');
        counted = sessionStorage.getItem('inv_counted') === '1';
      } catch (e) {}
      var fresh = !!(lead && lead.id && lead.ts && (Date.now() - lead.ts) < 30 * 60 * 1000);
      if (!fresh && !counted) {
        var ref = document.referrer || '';
        if (ref.indexOf(location.origin + '/') === 0 && ref.indexOf('/gracias') === -1) {
          lead = { id: 'ref-' + Date.now() + '-' + Math.random().toString(36).slice(2), ts: Date.now() };
          fresh = true;
        }
      }
      if (!fresh) return;
      try { sessionStorage.setItem('inv_counted', '1'); } catch (e) {}
      window.__invLead = lead;
      if (location.hostname !== 'invictussecurity.cl') {
        console.info(lead.calidad === 'curioso' ? '[gracias] lead curioso: sin conversión de Ads (simulado)' : '[gracias] conversión simulada (no es producción)', lead);
        return;
      }

      // Las campañas son para leads de contratación: un "curioso" (solo averiguando) queda
      // registrado en hapee y en GA4, pero NO cuenta como conversión de Google Ads.
      var calificado = lead.calidad !== 'curioso';

      function fire() {
        window.dataLayer = window.dataLayer || [];
        var ud = lead.user_data || {};
        dataLayer.push({ event: 'generate_lead', lead_id: lead.id, segmento: lead.segmento || '', lead_quality: lead.calidad || 'calificado', user_data: ud });
        // GTM
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-WNTMK96Q');
        if (!calificado) return;
        // Conversión primaria de Ads (gtag) con transaction_id y datos para Enhanced Conversions
        var gs = document.createElement('script');
        gs.async = true;
        gs.src = 'https://www.googletagmanager.com/gtag/js?id=AW-17648531850';
        document.head.appendChild(gs);
        window.gtag = window.gtag || function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', 'AW-17648531850', { allow_enhanced_conversions: true });
        if (ud.email || ud.phone_number) gtag('set', 'user_data', ud);
        gtag('event', 'conversion', { send_to: 'AW-17648531850/OcKZCPrpu50cEIrzvN9B', transaction_id: lead.id });
      }
      // Si la página se pre-renderizara, medir solo al activarse.
      if (document.prerendering) document.addEventListener('prerenderingchange', fire, { once: true });
      else fire();
    })();
  </script>

  <section class="ok on-dark">
    <div class="container container--narrow ok__inner">
      <div class="ok__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </div>
      <h1>¡Recibimos tu solicitud!</h1>
      <p class="ok__lead">Gracias por confiar en Invictus Security. Ya estamos trabajando en tu cotización.</p>
      <ol class="ok__steps" role="list">
        {pasos.map((p, i) => (
          <li>
            <span class="mono">{String(i + 1).padStart(2, '0')}</span>
            <div><strong>{p.t}</strong><p>{p.d}</p></div>
          </li>
        ))}
      </ol>
      <div class="ok__more">
        <p>Mientras tanto, te puede servir:</p>
        <a class="link-arrow" href="/guia/cuantos-guardias-necesito/">¿Cuántos guardias necesito?</a>
        <a class="link-arrow" href="/guia/ley-21659-seguridad-privada/">Qué cambia con la Ley 21.659</a>
      </div>
      <a class="btn btn--ghost" href="/">Volver al inicio</a>
    </div>
  </section>
</Base>
<style>
  .ok { background: radial-gradient(700px 400px at 50% -10%, rgb(34 197 94 / 0.16), transparent 60%), var(--ink); color: var(--on-dark); padding-block: clamp(48px, 8vw, 112px); min-height: calc(100svh - 68px); }
  .ok__inner { display: grid; gap: 22px; justify-items: center; text-align: center; }
  .ok__icon { width: 76px; height: 76px; border-radius: 50%; display: grid; place-items: center; background: var(--ok); color: var(--ink); box-shadow: 0 0 0 10px rgb(34 197 94 / 0.15); }
  .ok__icon svg { width: 38px; height: 38px; }
  @media (prefers-reduced-motion: no-preference) { .ok__icon { animation: popin 600ms var(--ease-out) both; } @keyframes popin { from { transform: scale(0.4); opacity: 0; } } }
  .ok h1 { font-size: clamp(2rem, 1.4rem + 2.4vw, 3.2rem); }
  .ok__lead { font-size: var(--fs-lg); color: var(--on-dark-2); }
  .ok__steps { list-style: none; padding: 0; display: grid; gap: 12px; text-align: left; width: 100%; max-width: 560px; margin-top: 8px; }
  .ok__steps li { display: flex; gap: 16px; padding: 16px 18px; border: 1px solid var(--line-dark); border-radius: var(--r); background: rgb(255 255 255 / 0.03); }
  .ok__steps .mono { color: var(--signal-2); padding-top: 2px; }
  .ok__steps p { color: var(--on-dark-2); font-size: var(--fs-sm); margin-top: 2px; }
  .ok__more { display: grid; gap: 4px; justify-items: center; color: var(--on-dark-3); font-size: var(--fs-sm); margin-top: 8px; }
</style>
