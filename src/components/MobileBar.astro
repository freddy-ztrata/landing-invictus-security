---
import { empresa } from '../data/empresa';
---
<div class="mbar" data-mbar aria-label="Acciones rápidas">
  <a class="mbar__tel" href={`tel:${empresa.telefono}`} data-track="call" data-placement="mobile-bar">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" fill="none" stroke="currentColor" stroke-width="2" /></svg>
    Llamar
  </a>
  <a class="btn mbar__cta" href="#cotizar" data-cta-cotizar data-track="cta" data-placement="mobile-bar">Cotizar gratis</a>
</div>

<script>
  // Visible en móvil solo cuando el formulario NO está en pantalla (evita duplicar el CTA).
  const bar = document.querySelector<HTMLElement>('[data-mbar]');
  const form = document.getElementById('cotizar');
  if (bar) {
    if (!form) {
      bar.querySelector<HTMLAnchorElement>('[data-cta-cotizar]')!.href = '/cotizar/';
      const show = () => bar.toggleAttribute('data-show', scrollY > 300);
      addEventListener('scroll', show, { passive: true });
      show();
    } else if ('IntersectionObserver' in window) {
      let formVisible = true;
      const update = () => bar.toggleAttribute('data-show', !formVisible && scrollY > 200);
      new IntersectionObserver(([e]) => { formVisible = e.isIntersecting; update(); }, { threshold: 0.05 }).observe(form);
      addEventListener('scroll', update, { passive: true });
    }
  }
</script>

<style>
  .mbar { display: none; }
  @media (max-width: 768px) {
    .mbar {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 900;
      display: grid; grid-template-columns: auto 1fr; gap: 10px;
      padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
      background: rgb(10 10 10 / 0.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid var(--line-dark);
      translate: 0 110%; transition: translate var(--dur-2) var(--ease-out);
    }
    .mbar[data-show] { translate: 0 0; }
    .mbar__tel { display: inline-flex; align-items: center; gap: 8px; min-height: 52px; padding: 0 18px; border-radius: var(--r-pill); border: 1px solid var(--line-dark-2); color: var(--on-dark); text-decoration: none; font-weight: 650; }
    .mbar__tel svg { width: 18px; height: 18px; color: var(--signal-2); }
    .mbar__cta { min-height: 52px; }
  }
</style>
