---
/**
 * Credencial / cumplimiento. Sin insignias de Carabineros (requiere autorización de uso).
 * El N° de autorización y el RUT se muestran solo cuando el cliente los entregue (empresa.ts).
 */
import { empresa } from '../data/empresa';
const items = [
  { t: 'Personal con credencial vigente', d: 'Cada guardia cuenta con la credencial y la capacitación exigidas por la normativa de seguridad privada.' },
  { t: 'Contratos y cotizaciones al día', d: 'Guardias con contrato de trabajo y cotizaciones previsionales pagadas. Puedes exigir el certificado F30-1 de la Dirección del Trabajo.' },
  { t: 'Seguros vigentes', d: 'Seguro de vida, de accidentes y de responsabilidad civil para proteger a tu organización y a las personas.' },
  { t: 'Fiscalizable en todo momento', d: 'Operamos bajo la Ley 21.659 de Seguridad Privada, con Carabineros de Chile como autoridad fiscalizadora.' },
];
---
<section class="section section--dark credential" aria-labelledby="cred-title">
  <div class="container cred">
    <div class="cred__card" aria-hidden="true">
      <div class="cred__chip"></div>
      <p class="cred__k mono">CREDENCIAL DE SERVICIO</p>
      <p class="cred__name">{empresa.nombre}</p>
      <dl class="cred__rows mono">
        <div><dt>MARCO</dt><dd>LEY 21.659</dd></div>
        <div><dt>FISCALIZA</dt><dd>CARABINEROS · OS-10</dd></div>
        <div><dt>OPERACIÓN</dt><dd>24/7 · RM</dd></div>
        {empresa.autorizacion.numero && <div><dt>N° AUT.</dt><dd>{empresa.autorizacion.numero}</dd></div>}
      </dl>
      <div class="cred__scan"></div>
    </div>
    <div>
      <div class="section-head">
        <span class="eyebrow">Cumplimiento</span>
        <h2 id="cred-title">Contratar seguridad no debería ser <span class="accent">un riesgo legal</span></h2>
        <p>Desde el 28 de noviembre de 2025 rige la nueva Ley 21.659 de Seguridad Privada. Trabajar con una empresa que cumple te protege ante fiscalizaciones, accidentes y deudas laborales de terceros.</p>
      </div>
      <ul class="cred__list" role="list">
        {items.map((i) => (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="m9 12 2 2 4-4" fill="none" stroke="currentColor" stroke-width="2" /></svg>
            <div><h3>{i.t}</h3><p>{i.d}</p></div>
          </li>
        ))}
      </ul>
      <a class="link-arrow" href="/guia/ley-21659-seguridad-privada/">Qué cambia con la Ley 21.659</a>
    </div>
  </div>
</section>

<style>
  .cred { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 6vw, 88px); align-items: center; }
  .cred__card {
    position: relative; overflow: hidden; aspect-ratio: 1.586; max-width: 440px; width: 100%; justify-self: center;
    border-radius: 20px; padding: 26px;
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(255 94 23 / 0.35), transparent 55%),
      linear-gradient(145deg, #1d1f23, #0e0f11);
    border: 1px solid var(--line-dark-2);
    box-shadow: 0 40px 80px -30px rgb(250 54 10 / 0.35), inset 0 1px 0 rgb(255 255 255 / 0.08);
    transform: perspective(900px) rotateY(-10deg) rotateX(6deg);
    transition: transform 900ms var(--ease-out);
  }
  .cred__card:hover { transform: perspective(900px) rotateY(0) rotateX(0); }
  .cred__chip { width: 46px; height: 34px; border-radius: 7px; background: linear-gradient(135deg, #ffd7a8, #c98a3d); opacity: 0.85; }
  .cred__k { margin-top: 18px; font-size: 0.66rem; letter-spacing: 0.2em; color: var(--on-dark-3); }
  .cred__name { font-family: var(--f-display); font-size: 1.5rem; color: var(--on-dark); letter-spacing: -0.02em; margin-top: 4px; }
  .cred__rows { margin-top: 14px; display: grid; gap: 4px; font-size: 0.68rem; letter-spacing: 0.08em; }
  .cred__rows div { display: flex; justify-content: space-between; border-bottom: 1px dashed var(--line-dark); padding-bottom: 3px; }
  .cred__rows dt { color: var(--on-dark-3); }
  .cred__rows dd { margin: 0; color: var(--on-dark); }
  .cred__scan { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgb(255 94 23 / 0.28) 50%, transparent 55%); background-size: 100% 220%; animation: scan 4.5s linear infinite; mix-blend-mode: screen; pointer-events: none; }
  @keyframes scan { from { background-position: 0 120%; } to { background-position: 0 -120%; } }
  @media (prefers-reduced-motion: reduce) { .cred__scan { animation: none; opacity: 0; } .cred__card { transform: none; } }
  .cred__list { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-bottom: 26px; }
  .cred__list li { display: flex; gap: 14px; }
  .cred__list svg { width: 26px; height: 26px; color: var(--signal-2); flex-shrink: 0; }
  .cred__list h3 { color: var(--on-dark); font-size: 1rem; margin-bottom: 4px; }
  .cred__list p { font-size: var(--fs-sm); }
  @media (max-width: 960px) { .cred { grid-template-columns: 1fr; } .cred__list { grid-template-columns: 1fr; } }
</style>
