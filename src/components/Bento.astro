---
/**
 * Servicios en bento. Cada tarjeta comparte view-transition-name con el hero de su landing:
 * al navegar, la foto "vuela" a la página destino (View Transitions cross-document, nativo).
 */
import { Picture } from 'astro:assets';
import { segmentos } from '../data/segmentos';
import imgPpi from '../assets/img/gen/ppi-escolta-ejecutiva.jpg';

interface Props { excluir?: string; titulo?: string; eyebrow?: string }
const { excluir, titulo = 'Seguridad privada para cada tipo de recinto', eyebrow = 'Servicios' } = Astro.props;
const lista = segmentos.filter((s) => s.slug !== excluir);
---
<section class="section section--bone" aria-labelledby="bento-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{eyebrow}</span>
      <h2 id="bento-title">{titulo}</h2>
      <p>Guardias acreditados, supervisión y protocolos diseñados para el riesgo real de tu recinto. Elige tu caso:</p>
    </div>
    <ul class="bento" role="list">
      {lista.map((s, i) => (
        <li class:list={['card', 'reveal', i === 0 && 'card--wide']}>
          <a href={`/${s.slug}/`} class="card__link">
            <span class="card__media viewfinder">
              <Picture
                src={s.imagen}
                formats={['avif', 'webp']}
                widths={[480, 720, 960, 1280]}
                sizes={i === 0 ? '(max-width: 760px) 100vw, 66vw' : '(max-width: 760px) 100vw, 33vw'}
                alt={s.imagenAlt}
                loading="lazy"
                decoding="async"
                style={`view-transition-name: seg-${s.slug}`}
              />
            </span>
            <span class="card__body">
              <span class="card__kicker mono">{String(i + 1).padStart(2, '0')} / {s.eyebrow}</span>
              <span class="card__title">{s.nav}</span>
              <span class="card__text">{s.lead}</span>
              <span class="link-arrow">Ver servicio</span>
            </span>
          </a>
        </li>
      ))}
      <li class="card card--ppi reveal">
        <a href="/seguridad-para-empresas/" class="card__link">
          <span class="card__media viewfinder">
            <Picture src={imgPpi} formats={['avif', 'webp']} widths={[480, 720, 960]} sizes="(max-width: 760px) 100vw, 33vw" alt="Escolta de protección ejecutiva abriendo la puerta de un vehículo en el distrito financiero de Santiago" loading="lazy" decoding="async" />
          </span>
          <span class="card__body">
            <span class="card__kicker mono">PPI / Escoltas</span>
            <span class="card__title">Protección de personas</span>
            <span class="card__text">Escoltas y protección ejecutiva con planificación de traslados y total discreción.</span>
            <span class="link-arrow">Cotizar escoltas</span>
          </span>
        </a>
      </li>
    </ul>
    <p class="section-cta"><a class="btn" href="#cotizar" data-cta-cotizar data-track="cta" data-placement="servicios">Solicita tu presupuesto gratis</a></p>
  </div>
</section>

<style>
  .bento { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .card { position: relative; border-radius: var(--r-lg); overflow: hidden; background: var(--ink); color: var(--on-dark); min-height: 380px; container-type: inline-size; }
  .card--wide { grid-column: span 2; }
  .card__link { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; text-decoration: none; color: inherit; }
  .card__media { position: absolute; inset: 0; }
  .card__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out), filter var(--dur-3); filter: saturate(0.9); }
  .card__media::before, .card__media::after { opacity: 0; transition: opacity var(--dur-2); }
  .card:hover .card__media :global(img) { transform: scale(1.05); filter: saturate(1.05); }
  .card:hover .card__media::before, .card:hover .card__media::after { opacity: 1; }
  .card__link::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 25%, rgb(10 10 10 / 0.88) 78%); pointer-events: none; }
  .card__body { position: relative; z-index: 1; display: grid; gap: 8px; padding: clamp(18px, 3cqi, 28px); }
  .card__kicker { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--signal-3); }
  .card__title { font-family: var(--f-display); font-size: clamp(1.3rem, 1rem + 2.4cqi, 2rem); font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; }
  .card__text { color: var(--on-dark-2); font-size: var(--fs-sm); max-width: 52ch; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card .link-arrow { color: var(--signal-3); min-height: 32px; }
  .card__link:focus-visible { outline: 3px solid var(--signal-2); outline-offset: -3px; border-radius: var(--r-lg); }
  @media (max-width: 960px) { .bento { grid-template-columns: 1fr 1fr; } .card--wide { grid-column: span 2; } }
  @media (max-width: 620px) { .bento { grid-template-columns: 1fr; } .card--wide { grid-column: auto; } .card { min-height: 340px; } }
</style>
