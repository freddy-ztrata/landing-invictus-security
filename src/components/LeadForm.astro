---
/**
 * Formulario de cotización = formulario de hapee nuevo embebido (iframe), sin webhook ni API propia.
 *   hapee: cliente 46, formulario 147 "Cotización web (invictussecurity.cl)" → crea el contacto,
 *   el negocio en el pipeline "Ventas web" (etapa Nuevo) y avisa a comercial@invictussecurity.cl.
 *   Los campos se editan en hapee (no aquí).
 * Un solo formulario por página (id="cotizar"): todos los CTA apuntan a #cotizar.
 * Los postulantes NO usan este formulario: el enlace de arriba los lleva a /trabaja-con-nosotros/.
 */
import { empresa } from '../data/empresa';
import type { SegmentoForm } from '../data/segmentos';
import { HAPEE_FORM_COTIZACION as HAPEE_FORM } from '../data/hapee';

interface Props {
  segmento?: SegmentoForm | null;
  titulo?: string;
  subtitulo?: string;
}
const {
  segmento = null,
  titulo = 'Cotiza tu servicio de seguridad',
  subtitulo = 'Para empresas, comunidades y productoras. Gratis, con respuesta en menos de 24 h hábiles.',
} = Astro.props;
---
<div class="lead" id="cotizar" data-lead-form data-segmento={segmento ?? ''} aria-labelledby="lead-title">
  <div class="lead__head">
    <p class="lead__title" id="lead-title">{titulo}</p>
    <p class="lead__sub">{subtitulo}</p>
  </div>

  <a class="lead__job" href="/trabaja-con-nosotros/" data-track="job_seeker" data-placement="form">
    <span class="lead__job-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm10 0v6m3-3h-6" /></svg>
    </span>
    <span><strong>¿Buscas empleo como guardia?</strong> Este formulario es solo para contratar servicios. Postula aquí →</span>
  </a>

  <!-- Atribución: hapee lee gclid/gbraid/wbraid/UTM SOLO de la URL de esta página. Si el visitante
       llegó por Ads a otra página del sitio, devolvemos a la URL el último toque guardado
       (scripts/attribution.ts) ANTES de que cargue el embed, para que el lead no pierda el gclid. -->
  <script is:inline>
    (function () {
      try {
        var KEYS = ['gclid', 'gbraid', 'wbraid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
        var url = new URL(location.href);
        if (KEYS.some(function (k) { return url.searchParams.get(k); })) return;
        var t = JSON.parse(localStorage.getItem('inv_attr_last') || localStorage.getItem('inv_attr_first') || 'null');
        if (!t || Date.now() - t.ts > 90 * 864e5) return;
        var added = false;
        KEYS.forEach(function (k) { if (t[k]) { url.searchParams.set(k, t[k]); added = true; } });
        if (added) history.replaceState(history.state, '', url.toString());
      } catch (e) {}
    })();
  </script>

  <div class="lead__frame">
    <div data-zentru-form={HAPEE_FORM} data-mode="inline" data-height="1010px"></div>
    <noscript>
      <p class="lead__noscript">Para cotizar en línea activa JavaScript, o llámanos al <a href={`tel:${empresa.telefono}`}>{empresa.telefonoVisible}</a> · <a href={`mailto:${empresa.email}`}>{empresa.email}</a></p>
    </noscript>
  </div>

  <ul class="lead__trust" role="list">
    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>Sin costo</li>
    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>Respuesta &lt; 24 h hábiles</li>
    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>Datos confidenciales</li>
  </ul>
  <p class="lead__legal">Al enviar aceptas nuestra <a href="/privacidad/">Política de Privacidad</a>.</p>
</div>

<!-- Embed oficial de hapee: convierte el div en iframe con auto-alto y avisa el envío (postMessage). -->
<script is:inline src="https://beta.hapee.ai/static/form-embed.js" defer></script>

<script>
  import { onHapeeSubmit } from '../scripts/form';
  onHapeeSubmit();
</script>

<style>
  .lead {
    position: relative;
    background: var(--paper);
    color: var(--text);
    border-radius: var(--r-lg);
    padding: clamp(18px, 2.6vw, 28px);
    box-shadow: var(--shadow-3);
    border: 1px solid var(--line);
    scroll-margin-top: 96px;
  }
  .lead::before {
    content: ''; position: absolute; inset: -1px -1px auto -1px; height: 3px; border-radius: var(--r-lg) var(--r-lg) 0 0;
    background: linear-gradient(90deg, transparent, var(--signal-2) 30%, var(--signal) 70%, transparent);
  }
  .lead__head { margin-bottom: 14px; }
  .lead__title { font-family: var(--f-display); font-weight: 600; font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem); letter-spacing: -0.02em; line-height: 1.2; color: var(--text); }
  .lead__sub { color: var(--text-3); font-size: var(--fs-sm); margin-top: 4px; }
  .lead__job {
    display: flex; gap: 12px; align-items: center;
    padding: 10px 12px; margin-bottom: 8px;
    border: 1.5px dashed var(--line); border-radius: var(--r);
    font-size: var(--fs-sm); color: var(--text-2); text-decoration: none; line-height: 1.35;
    transition: border-color var(--dur-1), background-color var(--dur-1);
  }
  .lead__job:hover { border-color: var(--text-3); background: var(--bone); }
  .lead__job strong { color: var(--text); }
  .lead__job-icon { flex-shrink: 0; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: var(--mist); color: var(--text-3); }
  .lead__job-icon svg { width: 18px; height: 18px; }
  /* Espacio reservado ≈ alto final del iframe: evita saltos (CLS) mientras carga el embed */
  .lead__frame { min-height: 1010px; margin-inline: -6px; }
  .lead__frame :global(iframe) { display: block; width: 100%; border: 0; }
  .lead__noscript { padding: 16px; font-size: var(--fs-sm); }
  .lead__trust { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 16px; margin: 6px 0 0; padding: 12px 0 0; border-top: 1px solid var(--line); font-size: var(--fs-xs); color: var(--text-3); }
  .lead__trust li { display: inline-flex; align-items: center; gap: 6px; }
  .lead__trust svg { width: 14px; height: 14px; color: var(--ok); }
  .lead__legal { font-size: var(--fs-xs); color: var(--text-3); text-align: center; margin-top: 6px; }
  .lead__legal a { color: inherit; }
</style>
