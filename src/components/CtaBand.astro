---
import { empresa } from '../data/empresa';
interface Props { titulo?: string; texto?: string; cta?: string; href?: string }
const {
  titulo = 'Cada noche sin protección es un riesgo que puedes evitar',
  texto = 'Cuéntanos qué necesitas proteger y recibe una propuesta en menos de 24 horas hábiles. Sin costo ni compromiso.',
  cta = 'Cotizar ahora',
  href = '#cotizar',
} = Astro.props;
---
<section class="band on-dark" aria-label="Solicitar cotización">
  <div class="container band__inner">
    <div>
      <h2>{titulo}</h2>
      <p>{texto}</p>
    </div>
    <div class="band__actions">
      <a class="btn" href={href} data-track="cta" data-placement="cta-band">{cta}</a>
      <a class="btn btn--ghost" href={`tel:${empresa.telefono}`} data-track="call" data-placement="cta-band">
        <span class="mono">{empresa.telefonoVisible}</span>
      </a>
    </div>
  </div>
</section>
<style>
  .band { position: relative; overflow: clip; background: var(--ink); color: var(--on-dark); padding-block: clamp(56px, 8vw, 104px); }
  .band::before { content: ''; position: absolute; inset: -40% -10% auto auto; width: 70%; aspect-ratio: 1; background: radial-gradient(closest-side, rgb(250 54 10 / 0.28), transparent); pointer-events: none; }
  .band::after { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px); background-size: 56px 56px; mask-image: linear-gradient(90deg, transparent, #000 40%, #000 60%, transparent); pointer-events: none; }
  .band__inner { position: relative; z-index: 1; display: grid; grid-template-columns: 1.4fr auto; gap: 32px; align-items: center; }
  .band h2 { font-size: clamp(1.6rem, 1.1rem + 2.2vw, 2.8rem); max-width: 22ch; }
  .band p { margin-top: 14px; color: var(--on-dark-2); max-width: 56ch; }
  .band__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 860px) { .band__inner { grid-template-columns: 1fr; } }
</style>
