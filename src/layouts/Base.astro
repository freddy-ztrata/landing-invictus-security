---
/**
 * Layout base: SEO, schema @graph, GTM, fuentes self-hosted, header/footer y barra móvil.
 * MPA puro (sin ClientRouter): cada navegación es una carga real → page_view correcto en GTM.
 */
import '../styles/base.css';
import '../styles/tokens.css';
// Fuentes self-hosted con @font-face propios y font-display: optional (+ preload): si la fuente
// no llega a tiempo se usa la del sistema en esa visita, sin saltos de layout (CLS). Los archivos
// vienen de @fontsource-variable y Vite les pone hash (/_astro/, cache 1 año).
import unboundedLatin from '@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url';
import unboundedLatinExt from '@fontsource-variable/unbounded/files/unbounded-latin-ext-wght-normal.woff2?url';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistLatinExt from '@fontsource-variable/geist/files/geist-latin-ext-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import monoLatinExt from '@fontsource-variable/geist-mono/files/geist-mono-latin-ext-wght-normal.woff2?url';

const LATIN = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT = 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';
const face = (family: string, weight: string, url: string, range: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:optional;font-weight:${weight};src:url(${url}) format('woff2-variations');unicode-range:${range}}`;
const fontFaces = [
  face('Unbounded Variable', '200 900', unboundedLatin, LATIN),
  face('Unbounded Variable', '200 900', unboundedLatinExt, LATIN_EXT),
  face('Geist Variable', '100 900', geistLatin, LATIN),
  face('Geist Variable', '100 900', geistLatinExt, LATIN_EXT),
  face('Geist Mono Variable', '100 900', monoLatin, LATIN),
  face('Geist Mono Variable', '100 900', monoLatinExt, LATIN_EXT),
].join('');
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { SITE_URL } from '../data/empresa';
import { nodoNegocio, nodoWebsite } from '../data/schema';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica con barra final, p. ej. "/guardias-de-seguridad/" */
  path: string;
  noindex?: boolean;
  ogImage?: string; // ruta absoluta en public/, p. ej. "/img/og/condominios.jpg"
  schema?: Record<string, unknown>[];
  /** Ocultar la barra móvil (p. ej. en /cotizar/ y /gracias/) */
  hideMobileBar?: boolean;
  /** Header mínimo (sin navegación) para /gracias/ */
  minimalHeader?: boolean;
  /** Medición: false en /gracias/ (allí se inyecta solo con token) */
  loadGtm?: boolean;
}

const {
  title,
  description,
  path,
  noindex = false,
  ogImage = '/img/og/home.jpg',
  schema = [],
  hideMobileBar = false,
  minimalHeader = false,
  loadGtm = true,
} = Astro.props;

const canonical = new URL(path, SITE_URL).href;
const ogUrl = new URL(ogImage, SITE_URL).href;
const graph = { '@context': 'https://schema.org', '@graph': [nodoNegocio(), nodoWebsite(), ...schema] };

// Speculation Rules: prefetch al pasar el cursor/tocar (moderate); prerender solo en "conservative".
// Nunca /gracias/ ni /api/.
const speculation = {
  prefetch: [{ where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/gracias/*' } }, { not: { href_matches: '/api/*' } }] }, eagerness: 'moderate' }],
  prerender: [{ where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/gracias/*' } }, { not: { href_matches: '/api/*' } }, { not: { href_matches: '/cotizar/*' } }] }, eagerness: 'conservative' }],
};
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {loadGtm && (
      <script is:inline>
        // GTM solo en producción: staging y local no ensucian GA4/Ads.
        if (location.hostname === 'invictussecurity.cl') {
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-WNTMK96Q');
        }
      </script>
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Invictus Security" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png" />

    <link rel="preload" href={unboundedLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>

    <slot name="head" />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <script type="speculationrules" set:html={JSON.stringify(speculation)} />
  </head>
  <body>
    {loadGtm && (
      <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WNTMK96Q" height="0" width="0" style="display:none;visibility:hidden" title="GTM"></iframe></noscript>
    )}
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header minimal={minimalHeader} />
    <main id="contenido">
      <slot />
    </main>
    <Footer minimal={minimalHeader} />
    {!hideMobileBar && <MobileBar />}
    <script>
      import '../scripts/attribution';
      import '../scripts/tracking';
    </script>
  </body>
</html>
