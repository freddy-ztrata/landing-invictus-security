---
/**
 * Layout de guías (contenido AEO/GEO): H1 + resumen citable + índice fijo + fuentes oficiales
 * + formulario al final. Schema Article con fecha de actualización.
 */
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LeadForm from '../components/LeadForm.astro';
import Faq from '../components/Faq.astro';
import type { Faq as FaqT } from '../data/segmentos';
import { SITE_URL } from '../data/empresa';
import { nodoBreadcrumb, nodoFaq, ORG_ID, WEBSITE_ID } from '../data/schema';

interface Props {
  slug: string;
  title: string;
  description: string;
  h1: string;
  resumen: string;
  actualizado: string; // ISO yyyy-mm-dd
  toc: { id: string; label: string }[];
  faqs?: FaqT[];
  ogImage?: string;
}
const { slug, title, description, h1, resumen, actualizado, toc, faqs = [], ogImage = '/img/og/home.jpg' } = Astro.props;
const url = `${SITE_URL}/guia/${slug}/`;
const crumbs = [
  { nombre: 'Inicio', url: `${SITE_URL}/` },
  { nombre: 'Guías', url: `${SITE_URL}/guia/${slug}/` },
  { nombre: h1, url },
];
const fecha = new Date(actualizado + 'T12:00:00').toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });
const article = {
  '@type': 'Article',
  '@id': `${url}#articulo`,
  headline: h1,
  description,
  inLanguage: 'es-CL',
  dateModified: actualizado,
  datePublished: actualizado,
  mainEntityOfPage: url,
  isPartOf: { '@id': WEBSITE_ID },
  author: { '@id': ORG_ID },
  publisher: { '@id': ORG_ID },
  image: new URL(ogImage, SITE_URL).href,
};
---
<Base
  title={title}
  description={description}
  path={`/guia/${slug}/`}
  ogImage={ogImage}
  schema={[article, nodoBreadcrumb([crumbs[0], crumbs[2]]), ...(faqs.length ? [nodoFaq(faqs, url)] : [])]}
>
  <header class="ghead on-dark">
    <div class="container container--narrow">
      <Breadcrumbs items={[crumbs[0], crumbs[2]]} tone="dark" />
      <span class="eyebrow"><span>Guía · Actualizada el <time datetime={actualizado}>{fecha}</time></span></span>
      <h1>{h1}</h1>
      <p class="ghead__tldr"><strong>Respuesta corta:</strong> {resumen}</p>
    </div>
  </header>

  <slot name="wide" />

  <div class="container gbody">
    <aside class="gtoc" aria-label="Contenido de la guía">
      <p class="mono gtoc__h">En esta guía</p>
      <ol>
        {toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
      </ol>
      <div class="gtoc__cta">
        <p>¿Necesitas guardias para tu recinto?</p>
        <a class="btn btn--sm btn--block" href="#cotizar" data-track="cta" data-placement="guide-toc">Cotizar gratis</a>
      </div>
    </aside>
    <article class="prose gart">
      <slot />
    </article>
  </div>

  {faqs.length > 0 && <Faq faqs={faqs} titulo="Preguntas frecuentes" id="faq-guia" />}

  <section class="section section--dark gform" aria-label="Cotización">
    <div class="container gform__grid">
      <div class="section-head">
        <span class="eyebrow">Cotiza con especialistas</span>
        <h2>Te ayudamos a definir la dotación y el servicio <span class="accent">que tu recinto necesita</span></h2>
        <p>Cuéntanos tu caso: te contactamos en menos de 24 horas hábiles con una propuesta sin costo.</p>
      </div>
      <LeadForm titulo="Solicita tu cotización" />
    </div>
  </section>
</Base>

<style>
  .ghead { background: var(--ink); color: var(--on-dark); padding: clamp(36px, 6vw, 80px) 0 clamp(36px, 5vw, 64px); position: relative; overflow: clip; }
  .ghead::after { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(70% 90% at 80% 0%, #000, transparent); pointer-events: none; }
  .ghead .container > * + * { margin-top: 18px; }
  .ghead h1 { font-size: clamp(2rem, 1.4rem + 2.6vw, 3.4rem); max-width: 22ch; }
  .ghead__tldr { font-size: var(--fs-lg); color: var(--on-dark-2); border-left: 3px solid var(--signal-2); padding-left: 18px; max-width: 70ch; }
  .ghead__tldr strong { color: var(--on-dark); }
  .gbody { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); padding-block: clamp(40px, 6vw, 80px); max-width: 1120px; }
  .gtoc { position: sticky; top: 96px; align-self: start; font-size: var(--fs-sm); }
  .gtoc__h { font-size: var(--fs-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-3); margin-bottom: 10px; }
  .gtoc ol { padding-left: 1.1em; display: grid; gap: 4px; }
  .gtoc a { color: var(--text-2); text-decoration: none; display: inline-block; padding: 4px 0; }
  .gtoc a:hover { color: var(--signal-ink); }
  .gtoc__cta { margin-top: 24px; padding: 18px; border-radius: var(--r); background: var(--bone); border: 1px solid var(--line); display: grid; gap: 10px; font-weight: 600; }
  .gart { max-width: 72ch; font-size: 1.05rem; }
  .gart :global(h2) { scroll-margin-top: 96px; }
  .gart :global(.callout) { padding: 18px 20px; border-radius: var(--r); background: var(--bone); border: 1px solid var(--line); }
  .gart :global(.sources) { font-size: var(--fs-sm); color: var(--text-3); }
  .gform__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 72px); align-items: center; }
  @media (max-width: 960px) {
    .gbody { grid-template-columns: 1fr; }
    .gtoc { position: static; }
    .gtoc__cta { display: none; }
    .gform__grid { grid-template-columns: 1fr; }
  }
</style>
