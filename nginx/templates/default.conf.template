# ─────────────────────────────────────────────────────────────────────────────
# Invictus Security — nginx (imagen oficial nginx:stable-alpine)
# Este archivo es un TEMPLATE: al arrancar, el entrypoint oficial lo procesa con envsubst
# (solo variables que calzan con NGINX_ENVSUBST_FILTER=^LEAD_) y lo escribe en
# /etc/nginx/conf.d/default.conf. Las variables propias de nginx ($uri, $args…) no se tocan.
#
# LEAD_WEBHOOK_URL: URL del webhook de hapee (workflow "Lead web"). SECRETO → variable de
# entorno de Dokploy. NUNCA en el repo (es público) ni en código de Astro.
# Este archivo se incluye dentro del bloque http {}, por eso los map/limit_req_zone van aquí.
# ─────────────────────────────────────────────────────────────────────────────

# Cache-Control por tipo de recurso. Headers SOLO a nivel server (sin add_header en las
# location) para no perder los de seguridad por la herencia de add_header.
map $uri $inv_cache_control {
    ~^/_astro/                                         "public, max-age=31536000, immutable";
    ~\.(avif|webp|jpe?g|png|gif|svg|ico|woff2?|mp4)$    "public, max-age=604800";
    ~^/api/                                            "no-store";
    default                                            "public, max-age=0, must-revalidate";
}

# noindex por cabecera (además del meta robots). Valor vacío = no se envía la cabecera.
map $uri $inv_robots_tag {
    ~^/(gracias|privacidad|trabaja-con-nosotros)/      "noindex";
    default                                            "";
}

# Redirecciones legacy (WordPress anterior y landing de una sola página).
# Se usan con $is_args$args: el gclid de los sitelinks/anuncios viejos NO se pierde.
# La primera regex que calza gana: lo específico va primero.
map $uri $inv_legacy {
    default                                                                   "";
    /invictus-landing.html                                                    /;
    /gracias.html                                                             /gracias/;
    /privacidad.html                                                          /privacidad/;
    /trabaja-con-nosotros.html                                                /trabaja-con-nosotros/;
    ~*^/(service|services|servicios|soluciones)/.*evento                      /guardias-para-eventos/;
    ~*^/(service|services|servicios|soluciones)/.*(condomin|residen|edific)  /seguridad-para-condominios/;
    ~*^/(service|services|servicios|soluciones)/.*(empresa|corporat|industri|bodega|ppi|escolta|ejecutiv|consultor|educacion|colegio) /seguridad-para-empresas/;
    ~*^/(service|services|servicios|soluciones)/.*guardia                     /guardias-de-seguridad/;
    ~*^/(service|services|servicios|soluciones)(/.*)?$                        /;
    ~*^/(contacto|contact|cotizacion|presupuesto)/?$                          /cotizar/;
    ~*^/(sobre-nosotros|quienes-somos|empresa|about)/?$                       /nosotros/;
    ~*^/(trabaja|trabajo|empleo|empleos|postula|postulaciones)/?$             /trabaja-con-nosotros/;
    ~*^/(blog|noticias|home|index\.php)(/.*)?$                                /;
}

# 6 envíos por minuto por IP real (ráfaga de 4). La IP real viene de Traefik (ver set_real_ip_from).
limit_req_zone $binary_remote_addr zone=inv_lead:10m rate=6r/m;

# Host canónico: www. y el subdominio viejo seguridad. → apex (Traefik pasa el Host original).
server {
    listen 80;
    server_name www.invictussecurity.cl seguridad.invictussecurity.cl;
    return 301 https://invictussecurity.cl$request_uri;
}

server {
    listen 80 default_server;
    server_name invictussecurity.cl _;
    root /usr/share/nginx/html;
    index index.html;

    # Redirecciones relativas (sin filtrar http://…:80 detrás de Traefik) y sin versión de nginx.
    absolute_redirect off;
    server_tokens off;

    # IP real del visitante detrás de Traefik/Dokploy (redes privadas de Docker). Con Cloudflare
    # delante, cambiar a: real_ip_header CF-Connecting-IP + rangos de Cloudflare.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Compresión: archivos .gz precomprimidos en el build + gzip al vuelo como respaldo.
    gzip on;
    gzip_static on;
    gzip_vary on;
    gzip_min_length 512;
    gzip_types text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json;

    add_header Cache-Control $inv_cache_control always;
    add_header X-Robots-Tag $inv_robots_tag always;
    include /etc/nginx/snippets/security-headers.conf;

    if ($inv_legacy) {
        return 301 $inv_legacy$is_args$args;
    }

    # Nunca servir archivos ocultos (.git, .env…).
    location ~ /\.(?!well-known/) {
        return 404;
    }

    location ~ ^/(wp-admin|wp-login\.php|wp-content|wp-includes|wp-json|xmlrpc\.php|feed)(/.*)?$ {
        return 410;
    }

    # El sitemap ahora lo genera @astrojs/sitemap.
    location = /sitemap.xml {
        return 301 /sitemap-index.xml;
    }

    # ── Leads: proxy al webhook de hapee ──────────────────────────────────────
    location = /api/lead {
        if ($request_method != POST) { return 405; }
        if ($http_origin !~* "^https://(invictussecurity\.cl|staging\.invictussecurity\.cl)$") { return 403; }

        limit_req zone=inv_lead burst=4 nodelay;
        limit_req_status 429;
        client_max_body_size 16k;
        client_body_buffer_size 16k;

        # Variable en proxy_pass → DNS por petición: nginx arranca aunque hapee no resuelva.
        resolver 127.0.0.11 1.1.1.1 8.8.8.8 valid=300s ipv6=off;
        resolver_timeout 3s;
        set $inv_lead_upstream "${LEAD_WEBHOOK_URL}";
        proxy_pass $inv_lead_upstream;

        proxy_set_header Content-Type "application/json";
        proxy_set_header Cookie "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_hide_header Set-Cookie;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_connect_timeout 4s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;

        # Fallas del upstream → JSON controlado (el formulario muestra el respaldo: llamar/email).
        proxy_intercept_errors on;
        error_page 500 502 503 504 = @lead_fail;
    }

    location @lead_fail {
        default_type application/json;
        return 502 '{"ok":false}';
    }

    location / {
        # Sin try_files a propósito: el módulo estático hace 301 /foo → /foo/ (conservando el
        # query string) y sirve index.html. Así no hay contenido duplicado con y sin barra.
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}
